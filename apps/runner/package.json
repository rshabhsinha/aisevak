{
  "name": "@aisevak/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @aisevak/core build && tsc -p tsconfig.json",
    "dev": "cd ../.. && NODE_OPTIONS='--conditions=development' tsx --env-file=.env watch apps/runner/src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aisevak/core": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
