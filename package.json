{
  "name": "aisevak",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted task runner for local Codex sessions with GitHub import.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @aisevak/api --filter @aisevak/runner --filter @aisevak/web dev",
    "dev:api": "pnpm --filter @aisevak/api dev",
    "dev:runner": "pnpm --filter @aisevak/runner dev",
    "dev:web": "pnpm --filter @aisevak/web dev",
    "dev:site": "pnpm --filter @aisevak/site dev",
    "build:site": "pnpm --filter @aisevak/site build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @aisevak/core migrate"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
