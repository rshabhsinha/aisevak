NODE_ENV=development
DATABASE_URL=postgres://aisevak:aisevak@localhost:5432/aisevak
APP_ORIGIN=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8787
COOKIE_SECRET=replace-with-at-least-32-random-bytes
SECRET_KEY=replace-with-32-byte-base64-key
MANAGED_ROOT=.aisevak-managed
# Set by scripts/install.sh on production hosts so the API can write the
# bind-mounted skill catalog without receiving access to runner credentials.
AISEVAK_RUNNER_UID=1000
AISEVAK_RUNNER_GID=1000
CODEX_BINARY=auto
CODEX_DEFAULT_MODEL=gpt-5.6-luna
API_URL=http://localhost:8787
RUNNER_POLL_MS=1500
# Maximum number of independent worker/dispatcher turns the host runner executes at once.
# Turns sharing an agent thread remain serialized, and direct-mode projects remain exclusive.
RUNNER_MAX_CONCURRENCY=4
DISPATCHER_HEARTBEAT_MS=300000
GITHUB_CLI=gh
GITHUB_HOST=github.com
